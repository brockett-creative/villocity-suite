<?xml version="1.0"?>
<ruleset name="VilloCity">
	<description>WordPress Coding Standards for VilloCity Suite.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/legacy/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="villocity-suite"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="villocity"/>
				<element value="BCG\VilloCity"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 class files (src/Foo/Bar.php) instead of WordPress's class-foo-bar.php naming. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/src/*</exclude-pattern>
		<exclude-pattern>/modules/*</exclude-pattern>
	</rule>
</ruleset>
